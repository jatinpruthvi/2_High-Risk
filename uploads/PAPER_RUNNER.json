  "signal": {
    "required_move_straddle_factor": 0.6,
    "rationale": "Proxies are research-grade approximations of the institutional scores. required_move is set as a fraction of the ATM straddle implied move so the Expected/Required gate can be met on genuinely moving days. Re-tune after observing live behaviour; never mistake PROXY scores for validated signals."
  },
  "config_overrides": {
    "_comment": "PAPER-ONLY overrides applied to a copy of PARAMETERS.json for the paper runner. PARAMETERS.json is never modified. IMPORTANT: with the frozen risk caps, a real NIFTY/BANKNIFTY ATM premium (required stop = 20% of premium x lot) always exceeds the Rs 750 cap, so no trade can fire. To watch the strategy trade in paper mode, uncomment an override below (e.g. premium_stop_pct 0.06). The dashboard shows a PAPER-ONLY OVERRIDE banner whenever these are active; such results are NOT valid evidence for live parameters.",
    "required_stop_model": {
      "enabled": true,
      "premium_stop_pct": 0.2
    },
    "exit_management": {
      "_comment": "PAPER-ONLY exit-management tuning: vol_time_stop_fraction exits dead trades once 35% of the holding window has passed and the remaining expected move can no longer reach the target; stop_exit_slippage_frac models gap-through-stop on risk-reducing exits (10% of 1R) so paper drawdown is an honest upper bound; edge_scaled_target gives high expected/required setups more room (up to 3R) and banks marginal ones earlier. None of these loosen the stop, so worst-case per-trade risk is unchanged. All paper-only.",
      "vol_time_stop_fraction": 0.35,
      "stop_exit_slippage_frac": 0.1,
      "edge_scaled_target": true,
      "edge_scale_min_ratio": 1.1,
      "edge_scale_min_r": 1.0,
      "edge_scale_max_r": 3.0
    },
    "risk": {
      "normal_risk_pct_of_capital": 5.0,
      "normal_risk_cap_rupees": 5000,
      "a_plus_risk_pct_of_capital": 6.0,
      "a_plus_risk_cap_rupees": 6000,
      "max_daily_loss_rupees": 8000
    },
    "instrument_risk_overrides": {
      "_comment": "PAPER-ONLY: PARAMETERS.json hardcodes per-underlying risk caps (750/1000) that shadow the section-level caps - these must be raised in paper mode too or the RiskCap gate still blocks every real NIFTY/BANKNIFTY trade.",
      "BANKNIFTY": {
        "normal_risk_cap_rupees": 5000,
        "a_plus_risk_cap_rupees": 6000
      },
      "NIFTY": {
        "normal_risk_cap_rupees": 5000,
        "a_plus_risk_cap_rupees": 6000
      },
      "FINNIFTY": {
        "normal_risk_cap_rupees": 5000,
        "a_plus_risk_cap_rupees": 6000
      },
      "MIDCPNIFTY": {
        "normal_risk_cap_rupees": 5000,
        "a_plus_risk_cap_rupees": 6000
      }
    },
    "instrument_calibration_status": {
      "_comment": "PAPER-ONLY: PARAMETERS.json marks every underlying UNVALIDATED, which subtracts 20 pts from every candidate score vs the 80-pt excellent threshold - with the frozen config no trade can EVER fire. PAPER mode marks direction/liquidity OBSERVED as an operational override so the strategy can be observed trading on live data. These results are NOT evidence for live parameters; the dashboard shows the override banner whenever this is active.",
      "BANKNIFTY": {
        "direction": "OBSERVED",
        "liquidity": "OBSERVED",
        "expected_move": "UNVALIDATED"
      },
      "NIFTY": {
        "direction": "OBSERVED",
